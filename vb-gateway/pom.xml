<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.visualbuilder</groupId>
        <artifactId>visual-builder-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>vb-gateway</artifactId>
    <name>VB Gateway</name>
    <description>启动模块：聚合所有业务模块，Spring Boot 入口</description>

    <dependencies>
        <!-- 聚合所有业务模块 -->
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-project</artifactId>
        </dependency>
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-page</artifactId>
        </dependency>
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-component</artifactId>
        </dependency>
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-template</artifactId>
        </dependency>
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-resource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-publish</artifactId>
        </dependency>
        <dependency>
            <groupId>com.visualbuilder</groupId>
            <artifactId>vb-system</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
