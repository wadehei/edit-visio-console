<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.visualbuilder</groupId>
    <artifactId>visual-builder-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Visual Builder Backend</name>
    <description>可视化装修平台后台管理系统</description>

    <modules>
        <module>vb-common</module>
        <module>vb-user</module>
        <module>vb-project</module>
        <module>vb-page</module>
        <module>vb-component</module>
        <module>vb-template</module>
        <module>vb-resource</module>
        <module>vb-publish</module>
        <module>vb-system</module>
        <module>vb-gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 内部模块版本 -->
        <vb.version>1.0.0-SNAPSHOT</vb.version>

        <!-- 依赖版本 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <knife4j.version>4.4.0</knife4j.version>
        <minio.version>8.5.10</minio.version>
        <jjwt.version>0.12.5</jjwt.version>
        <hutool.version>5.8.27</hutool.version>
        <redisson.version>3.27.2</redisson.version>
    </properties>

    <!-- 依赖版本管理 -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-common</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-user</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-project</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-page</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-component</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-template</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-resource</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-publish</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-system</artifactId>
                <version>${vb.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Knife4j (Swagger增强) -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- MinIO -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Hutool 工具集 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有模块公共依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
