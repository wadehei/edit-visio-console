<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.visualbuilder</groupId>
    <artifactId>visual-builder-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Visual Builder Backend</name>
    <description>可视化装修平台后台管理系统</description>

    <modules>
        <module>vb-common</module>
        <module>vb-user</module>
        <module>vb-project</module>
        <module>vb-page</module>
        <module>vb-component</module>
        <module>vb-template</module>
        <module>vb-resource</module>
        <module>vb-publish</module>
        <module>vb-system</module>
        <module>vb-gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 内部模块版本 -->
        <vb.version>1.0.0-SNAPSHOT</vb.version>

        <!-- 依赖版本 -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <knife4j.version>4.4.0</knife4j.version>
        <minio.version>8.5.10</minio.version>
        <jjwt.version>0.12.5</jjwt.version>
        <hutool.version>5.8.27</hutool.version>
        <redisson.version>3.27.2</redisson.version>
        <jsoup.version>1.17.2</jsoup.version>
        <jacoco.version>0.8.11</jacoco.version>

        <!-- 覆盖率门禁阈值（漂移门禁：覆盖率不得低于该比例，低于即 verify 失败）
             全局默认值；覆盖率偏低的模块可在自身 pom 的 <properties> 内按同名 key 覆盖。 -->
        <jacoco.line.ratio>0.15</jacoco.line.ratio>
        <jacoco.branch.ratio>0.10</jacoco.branch.ratio>
    </properties>

    <!-- 依赖版本管理 -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-common</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <!-- vb-common 的 test-jar：仅供各模块 *IT 复用 ItEnv 等测试基建 -->
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-common</artifactId>
                <version>${vb.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-user</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-project</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-page</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-component</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-template</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-resource</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-publish</artifactId>
                <version>${vb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.visualbuilder</groupId>
                <artifactId>vb-system</artifactId>
                <version>${vb.version}</version>
            </dependency>

            <!-- MyBatis-Plus -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Knife4j (Swagger增强) -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- MinIO -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Hutool 工具集 -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Jsoup：发布渲染时的 HTML 白名单过滤，替代易被绕过的正则过滤 -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有模块公共依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <!--
              集成测试（*IT）由 failsafe 在 verify 阶段执行，不进入 test 阶段。
              原因：*IT 依赖本机真实中间件（Redis/MySQL），而 `mvn test` 必须在无外部依赖时也能通过。
              运行方式：mvn verify
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              JaCoCo 覆盖率门禁（漂移门禁）：
              · prepare-agent 在 initialize 阶段挂载探针；
              · report/check 绑定 verify 阶段，低于 line/branch 阈值即构建失败。
              排除 dto/entity/config/constant 等无逻辑样板类，让门禁聚焦于 service/controller 业务逻辑。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/entity/**</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/core/constant/**</exclude>
                        <exclude>**/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.ratio}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.ratio}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
